rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // isAdmin checks the custom claim set by the setUserRole CF:
    //   admin.auth().setCustomUserClaims(uid, { role: 'admin' })
    // The token claim is `role`, not `admin`.
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Admin users get full read/write access to all collections.
    // Cloud Functions use Admin SDK which bypasses these rules entirely.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Blanket deny for non-admin, non-specific paths.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Bourse ───────────────────────────────────────────────────────────────
    match /bourse_opportunities/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /bourse_prices/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Financing ─────────────────────────────────────────────────────────────
    match /farmers/{farmerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /financing_applications/{appId} {
      allow read: if request.auth != null
        && (resource.data.investorId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.investorId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /agent_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.agentId == request.auth.uid;
    }

    match /cultural_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Academia ──────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
